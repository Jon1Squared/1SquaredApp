# -----------------------------------------------------------------------------
# 1Squared Platform — Local Development Environment Template
# Copy this file to .env.local and fill in your local Entra ID values.
# Never commit real secrets to source control (Rule 5).
# -----------------------------------------------------------------------------

# 1. Microsoft Entra ID — App Registration
ENTRA_CLIENT_ID="<YOUR_APPLICATION_CLIENT_ID>"
ENTRA_TENANT_ID="<YOUR_DIRECTORY_TENANT_ID>"
ENTRA_CLIENT_SECRET="<YOUR_CLIENT_SECRET_VALUE>"
ENTRA_REDIRECT_URI="http://localhost:3000/api/auth/callback/microsoft-entra-id"

# 2. Platform Hosting Mode ("single_tenant" or "multi_tenant"), Environment ("dev" | "test" | "training" | "demo" | "live") & Tenant Package
PLATFORM_HOSTING_MODE="single_tenant"
PLATFORM_ENVIRONMENT="dev"
PLATFORM_TENANT_PACKAGE_DIR="client-not-a-law-firm"

# Optional override for the transitional JSON runtime store path (defaults to data/runtime-store.json).
# On a fresh checkout, seed the local store with:
#   PLATFORM_TENANT_PACKAGE_DIR=client-not-a-law-firm PLATFORM_ENVIRONMENT=dev npm run seed:demo
ONESQUARED_RUNTIME_STORE_PATH="data/runtime-store.json"

# 3. Session & Scoped Blob Token Signing Secrets
AUTH_SECRET="<GENERATE_WITH_OPENSSL_RAND_BASE64_32>"
PLATFORM_BLOB_SIGNING_KEY="<GENERATE_WITH_OPENSSL_RAND_BASE64_32>"

# 4. Server-Side External Service API Keys (populated from Azure Key Vault in deployed environments)
IDEAL_POSTCODES_API_KEY=""
ANTHROPIC_API_KEY=""

# 5. Observability — Azure Application Insights (optional in dev/test and Model A; exported when set)
APPLICATIONINSIGHTS_CONNECTION_STRING=""

# 6. Per-Tenant PostgreSQL 16 & PgBouncer (local Docker Compose: docker compose -f docker-compose.postgres.yml up -d)
# Runtime queries connect via PgBouncer transaction pooler (port 6432) as NOINHERIT runtime_login;
# migrations connect directly to port 5432 as migrate_login (ADR 0028, R401, R402).
PLATFORM_POSTGRES_HOST="127.0.0.1"
PLATFORM_POSTGRES_PORT="6432"
PLATFORM_POSTGRES_MIGRATE_PORT="5432"
PLATFORM_POSTGRES_RUNTIME_USER="runtime_login"
PLATFORM_POSTGRES_MIGRATE_USER="migrate_login"
# Password authentication (local PostgreSQL only). Required when PLATFORM_POSTGRES_AUTH_MODE is not
# entra_managed_identity: core has no built-in passwords (R435). Admin values are used only by
# scripts/setup-test-postgres.mjs to provision the local cluster.
PLATFORM_POSTGRES_RUNTIME_PASSWORD="<LOCAL_RUNTIME_PASSWORD>"
PLATFORM_POSTGRES_MIGRATE_PASSWORD="<LOCAL_MIGRATE_PASSWORD>"
PLATFORM_POSTGRES_ADMIN_USER="postgres"
PLATFORM_POSTGRES_ADMIN_PASSWORD="<LOCAL_ADMIN_PASSWORD>"
