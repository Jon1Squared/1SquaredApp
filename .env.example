# -----------------------------------------------------------------------------
# 1Squared Platform — Local Development Environment Template
# Copy this file to .env.local and fill in your local Entra ID values.
# Never commit real secrets to source control (Rule 5).
# -----------------------------------------------------------------------------

# 1. Microsoft Entra ID — App Registration
ENTRA_CLIENT_ID="<YOUR_APPLICATION_CLIENT_ID>"
ENTRA_TENANT_ID="<YOUR_DIRECTORY_TENANT_ID>"
ENTRA_CLIENT_SECRET="<YOUR_CLIENT_SECRET_VALUE>"
ENTRA_REDIRECT_URI="http://localhost:3000/api/auth/callback/microsoft-entra-id"

# 2. Platform Hosting Mode ("single_tenant" or "multi_tenant") & Tenant Package
PLATFORM_HOSTING_MODE="single_tenant"
PLATFORM_TENANT_PACKAGE_DIR="client-not-a-law-firm"

# 3. Session & Scoped Blob Token Signing Secrets
AUTH_SECRET="<GENERATE_WITH_OPENSSL_RAND_BASE64_32>"
PLATFORM_BLOB_SIGNING_KEY="<GENERATE_WITH_OPENSSL_RAND_BASE64_32>"
