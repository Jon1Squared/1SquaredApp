{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.1squared.uk/schemas/tenant-config.schema.json",
  "title": "TenantConfiguration",
  "description": "Schema-validated per-tenant configuration owned by @platform/core",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tenantId",
    "displayName",
    "hostingMode",
    "environment",
    "branding",
    "featureFlags",
    "matterCosts",
    "integrations",
    "enabledExtensions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "default": "1.0.0",
      "description": "Semantic version of the configuration schema"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,48}[a-z0-9]$",
      "description": "Unique immutable tenant slug"
    },
    "displayName": {
      "type": "string",
      "description": "Tenant display name"
    },
    "hostingMode": {
      "type": "string",
      "enum": ["single_tenant", "multi_tenant"],
      "default": "multi_tenant",
      "description": "Deployment tenancy mode"
    },
    "environment": {
      "type": "string",
      "enum": ["dev", "test", "training", "live"],
      "default": "dev",
      "description": "Target deployment environment"
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryDomain", "accentColorHex", "logoAssetKey"],
      "properties": {
        "primaryDomain": { "type": "string" },
        "accentColorHex": { "type": "string", "default": "#1f6feb" },
        "logoAssetKey": { "type": "string", "default": "default-logo.svg" }
      }
    },
    "featureFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enableMatterCostsGovernance",
        "enablePmsLiveRateSync",
        "enableAiMatterExtraction"
      ],
      "properties": {
        "enableMatterCostsGovernance": { "type": "boolean", "default": true },
        "enablePmsLiveRateSync": { "type": "boolean", "default": true },
        "enableAiMatterExtraction": { "type": "boolean", "default": false }
      }
    },
    "matterCosts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rateSourceMode",
        "allowMatterRateOverrides",
        "partnerSignOffThresholdGbp",
        "rateCards",
        "disbursementPresets"
      ],
      "properties": {
        "rateSourceMode": {
          "type": "string",
          "enum": ["application_table", "pms_when_linked"],
          "default": "pms_when_linked"
        },
        "allowMatterRateOverrides": { "type": "boolean", "default": true },
        "partnerSignOffThresholdGbp": { "type": "number", "default": 25000 },
        "rateCards": { "type": "array" },
        "disbursementPresets": { "type": "array" }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pmsConnectionSecretVaultRef",
        "companiesHouseApiKeyVaultRef",
        "aiProviderChoice"
      ],
      "properties": {
        "pmsConnectionSecretVaultRef": { "type": "string" },
        "companiesHouseApiKeyVaultRef": { "type": "string" },
        "aiProviderChoice": {
          "type": "string",
          "enum": ["azure_openai_uk", "disabled"],
          "default": "disabled"
        },
        "pmsSync": {
          "type": "object",
          "additionalProperties": false,
          "description": "Two-way Finance/PMS synchronisation settings and field mappings",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "providerKey": { "type": "string", "default": "generic_sql" },
            "syncMode": {
              "type": "string",
              "enum": ["read_only", "two_way"],
              "default": "two_way"
            },
            "matterCodeAllocation": {
              "type": "string",
              "enum": ["onesquared", "pms_on_open"],
              "default": "onesquared"
            },
            "clientCodeAllocation": {
              "type": "string",
              "enum": ["onesquared", "pms_on_open"],
              "default": "onesquared"
            },
            "pollIntervalMinutes": { "type": "integer", "default": 15 },
            "fieldMappings": {
              "type": "array",
              "default": [],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "entityType",
                  "onesquaredFieldKey",
                  "externalFieldKey",
                  "ownership",
                  "active"
                ],
                "properties": {
                  "id": { "type": "string" },
                  "entityType": {
                    "type": "string",
                    "enum": [
                      "client_organisation",
                      "client_person",
                      "matter",
                      "fee_estimate",
                      "employee"
                    ]
                  },
                  "onesquaredFieldKey": { "type": "string" },
                  "externalFieldKey": { "type": "string" },
                  "ownership": {
                    "type": "string",
                    "enum": ["onesquared_master", "pms_master", "bidirectional"],
                    "default": "onesquared_master"
                  },
                  "active": { "type": "boolean", "default": true }
                }
              }
            }
          }
        }
      }
    },
    "customFields": {
      "type": "array",
      "description": "Per-client custom fields, screen locations, and mandatory rules",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "recordType",
          "label",
          "fieldType",
          "section",
          "required",
          "sortOrder",
          "active"
        ],
        "properties": {
          "id": { "type": "string" },
          "recordType": {
            "type": "string",
            "enum": ["enquiry", "person", "organisation", "matter", "quote", "task"]
          },
          "label": { "type": "string" },
          "fieldType": {
            "type": "string",
            "enum": ["text", "longText", "number", "date", "yesNo", "choice"]
          },
          "optionsListKey": { "type": "string" },
          "options": {
            "type": "array",
            "items": { "type": "string" }
          },
          "section": { "type": "string", "default": "additional" },
          "required": { "type": "boolean", "default": false },
          "sortOrder": { "type": "integer", "default": 1 },
          "active": { "type": "boolean", "default": true }
        }
      }
    },
    "enabledExtensions": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
