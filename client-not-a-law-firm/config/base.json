  "matterFolderTemplates": {
    "default": {
      "templateId": "tpl-firm-default",
      "version": 1,
      "mode": "replaces",
      "description": "Standard firm matter folder structure",
      "nodes": [
        {
          "name": "01 Client Care",
          "description": "Engagement letters, terms of business, and AML/CDD records",
          "filingAliases": ["client_care", "engagement", "cdd"]
        },
        {
          "name": "02 Correspondence",
          "description": "Inbound and outbound correspondence with clients, counterparties, and third parties",
          "filingAliases": ["correspondence", "letters", "emails"]
        },
        {
          "name": "03 Drafts",
          "description": "Working drafts and internal notes",
          "filingAliases": ["drafts", "working_papers"]
        },
        {
          "name": "04 Final Documents",
          "description": "Executed agreements, engrossments, and final deliverables",
          "filingAliases": ["final_documents", "executed"]
        },
        {
          "name": "05 Billing and Finance",
          "description": "Bills, cost estimates, disbursements, and completion statements",
          "filingAliases": ["billing", "finance", "invoices"]
        }
      ]
    },
    "byWorkType": {
      "work_type.real_estate_and_property": {
        "templateId": "tpl-conveyancing",
        "version": 1,
        "mode": "extends",
        "description": "Conveyancing and property transaction folder structure extending the firm default",
        "operations": [
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03a Searches and Enquiries",
              "description": "Local authority, drainage, environmental searches and CPSE/TA enquiries",
              "filingAliases": ["searches", "enquiries"]
            }
          },
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03b Title and Contract",
              "description": "Official copies, title plans, epitomes, and contract pack",
              "filingAliases": ["title", "contract", "transfer"]
            }
          },
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03c Completion and Post-Completion",
              "description": "Completion undertakings, SDLT/LTT returns, and HM Land Registry AP1 registration",
              "filingAliases": ["completion", "sdlt", "hmlr"]
            }
          }
        ]
      },
      "work_type.real_estate_and_property_residential_conveyancing": {
        "templateId": "tpl-residential-conveyancing",
        "version": 1,
        "mode": "extends",
        "description": "Residential conveyancing folder structure extending the firm default",
        "operations": [
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03a Searches and Enquiries",
              "description": "Local authority, drainage, environmental searches and TA forms",
              "filingAliases": ["searches", "enquiries"]
            }
          },
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03b Title and Contract",
              "description": "Official copies, title plans, and draft contract",
              "filingAliases": ["title", "contract"]
            }
          },
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03c Completion and Post-Completion",
              "description": "Completion statement, SDLT return, and HMLR registration",
              "filingAliases": ["completion", "post_completion"]
            }
          }
        ]
      },
      "work_type.dispute_resolution": {
        "templateId": "tpl-litigation",
        "version": 1,
        "mode": "extends",
        "description": "Dispute Resolution and Litigation folder structure extending the firm default",
        "operations": [
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03a Pleadings",
              "description": "Claim form, particulars of claim, defence, reply, and court orders",
              "filingAliases": ["pleadings", "statements_of_case", "orders"]
            }
          },
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03b Disclosure and Evidence",
              "description": "Disclosure lists, key documents, and inspection bundles",
              "filingAliases": ["disclosure", "evidence"]
            }
          },
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03c Witness Statements and Experts",
              "description": "Fact witness statements, instructions to experts, and expert reports",
              "filingAliases": ["witness_statements", "experts"]
            }
          },
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03d Counsel and Hearings",
              "description": "Briefs to counsel, skeleton arguments, and hearing bundles",
              "filingAliases": ["counsel", "hearings", "bundles"]
            }
          },
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03e Settlement and ADR",
              "description": "Part 36 offers, mediation position statements, and Tomlin orders",
              "filingAliases": ["settlement", "adr", "mediation"]
            }
          }
        ]
      },
      "work_type.dispute_resolution_court_pleadings": {
        "templateId": "tpl-litigation-pleadings",
        "version": 1,
        "mode": "extends",
        "description": "Court pleadings and civil litigation folder structure extending the firm default",
        "operations": [
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03a Pleadings",
              "description": "Claim form, particulars of claim, defence, reply, and court orders",
              "filingAliases": ["pleadings", "orders"]
            }
          },
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03b Disclosure and Evidence",
              "description": "Disclosure lists and evidence bundles",
              "filingAliases": ["disclosure", "evidence"]
            }
          },
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03c Witness Statements and Experts",
              "description": "Witness statements and expert reports",
              "filingAliases": ["witness_statements", "experts"]
            }
          },
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03d Counsel and Hearings",
              "description": "Instructions to counsel and hearing bundles",
              "filingAliases": ["counsel", "hearings"]
            }
          },
          {
            "op": "add",
            "parentPath": "/",
            "node": {
              "name": "03e Settlement and ADR",
              "description": "Part 36 offers, mediation, and settlement agreements",
              "filingAliases": ["settlement", "adr"]
            }
          }
        ]
      }
    }
