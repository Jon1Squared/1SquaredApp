    "reminderSchedules": [
      {
        "id": "standard",
        "label": "Standard",
        "stages": [
          { "daysBefore": 30, "priority": "normal" },
          { "daysBefore": 7, "priority": "high" },
          { "daysBefore": 1, "priority": "urgent" },
          { "daysBefore": 0, "priority": "urgent" }
        ],
        "escalation": { "afterUnacknowledgedDays": 2, "levels": ["team_leads"] }
      },
      {
        "id": "limitation",
        "label": "Limitation",
        "stages": [
          { "daysBefore": 90, "priority": "normal" },
          { "daysBefore": 60, "priority": "normal" },
          { "daysBefore": 30, "priority": "high" },
          { "daysBefore": 14, "priority": "high" },
          { "daysBefore": 7, "priority": "urgent" },
          { "daysBefore": 1, "priority": "urgent" },
          { "daysBefore": 0, "priority": "urgent" }
        ],
        "escalation": { "afterUnacknowledgedDays": 1, "levels": ["team_leads", "role:risk_compliance"] }
      }
    ],
    "limitationRuleSets": [
      {
        "id": "ew-sample",
        "version": 1,
        "label": "England & Wales – SAMPLE, requires solicitor review",
        "jurisdiction": "england_and_wales",
        "reviewStatus": "unreviewed",
        "rules": [
          {
            "id": "contract-simple",
            "label": "Simple contract",
            "claimType": "contract",
            "guidanceNote": "Sample only. Confirm the period and trigger with a solicitor before relying on this rule.",
            "trigger": { "kind": "single", "field": "accrualDate" },
            "period": { "years": 6 },
            "calendarId": "england-and-wales",
            "minorityAdjustment": { "enabled": true }
          },
          {
            "id": "personal-injury",
            "label": "Personal injury",
            "claimType": "personal_injury",
            "guidanceNote": "Sample only. Confirm the period, trigger and any discretion with a solicitor.",
            "trigger": { "kind": "later_of", "fields": ["accrualDate", "dateOfKnowledge"] },
            "period": { "years": 3 },
            "calendarId": "england-and-wales",
            "minorityAdjustment": { "enabled": true }
          }
        ]
      }
    ],
    "businessCalendars": [
      {
        "id": "england-and-wales",
        "label": "England and Wales",
        "weekendDays": [0, 6],
        "source": "manual",
        "nonWorkingDates": [
          "2026-01-01", "2026-04-03", "2026-04-06", "2026-05-04",
          "2026-05-25", "2026-08-31", "2026-12-25", "2026-12-28"
        ]
